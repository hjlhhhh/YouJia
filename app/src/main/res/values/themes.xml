<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 应用主题 -->
    <style name="Theme.YouJia" parent="Theme.Material3.Light.NoActionBar">
        <!-- 基础颜色 -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryContainer">@color/purple_100</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorTertiary">@color/blue_500</item>
        <item name="colorOnTertiary">@color/white</item>

        <!-- 表面色 -->
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>

        <!-- 错误 -->
        <item name="colorError">@color/red_500</item>
        <item name="colorOnError">@color/white</item>

        <!-- 状态栏 -->
        <item name="android:statusBarColor">?attr/colorSurface</item>
    </style>
    <style name="CustomToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>