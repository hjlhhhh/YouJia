<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 暗色主题：与亮色同名，父主题改为 Dark -->
    <style name="Theme.YouJia" parent="Theme.Material3.Dark.NoActionBar">
        <!-- 颜色引用名称与亮色完全一致，但实际值在 values-night/colors.xml 中覆盖 -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryContainer">@color/purple_100</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorTertiary">@color/blue_500</item>
        <item name="colorOnTertiary">@color/white</item>

        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>

        <item name="colorError">@color/red_500</item>
        <item name="colorOnError">@color/white</item>

        <item name="android:statusBarColor">?attr/colorSurface</item>
    </style>

</resources>